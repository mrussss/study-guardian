{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudyGuardian Pet v3",
  "version": "0.1.0",
  "identifier": "com.studyguardian.pet-v3",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StudyGuardian Pet v3",
        "width": 220,
        "height": 220,
        "minWidth": 160,
        "minHeight": 160,
        "maxWidth": 260,
        "maxHeight": 260,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
